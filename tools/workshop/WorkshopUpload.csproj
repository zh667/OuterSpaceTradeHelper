<Project Sdk="Microsoft.NET.Sdk">
  <!-- Steam Workshop uploader (tools/workshop.py builds and runs it on Windows). Uses the game's own Steamworks.NET;
       steam_api64.dll is copied next to the exe by workshop.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\bin\workshop\</OutputPath>
    <GameManaged Condition="'$(GameManaged)' == ''">E:\SteamLibrary\steamapps\common\Outer Space\Outer Space_Data\Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(GameManaged)\com.rlabrecque.steamworks.net.dll</HintPath><Private>true</Private></Reference>
    <!-- Steamworks.NET's Unity build refers to it (logging); copied so the exe can load it outside the game -->
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
